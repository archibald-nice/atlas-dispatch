{
  "name": "atlas-dispatch",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "companion": "node scripts/companion.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "update": "node scripts/release.mjs prepare --refresh",
    "release": "node scripts/release.mjs",
    "oss:export": "node scripts/export-oss.mjs",
    "sources:list": "node scripts/refresh.mjs --list",
    "refresh": "node scripts/refresh.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "5.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "agentation": "3.1.2",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
